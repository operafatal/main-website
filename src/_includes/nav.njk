      {# JS-Buchstabenmarke deaktiviert; bei Bedarf statt Logo wieder aktivieren.
      <span class="site-header__brand-mark site-header__brand-mark--letters" aria-hidden="true">
        <span class="site-header__brand-letter site-header__brand-letter--j">J</span>
        <span class="site-header__brand-letter site-header__brand-letter--s">S</span>
      </span>
      #}
    </a>
    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul class="site-nav__list">
