{% macro eventFeatureRow(event) %}
  <article class="event-feature-row">
    <div class="event-feature-row__body">
      <p class="event-feature-row__date">{{ event.date }}</p>
      <p class="event-feature-row__place" translate="no">{{ event.institution or event.location }}</p>
      <h3 class="event-feature-row__title">{{ event.title }}</h3>
      <p class="event-feature-row__summary">{{ event.summary }}</p>
      {% if event.href %}
        <a class="pill-button pill-button--ghost pill-button--compact event-feature-row__button" href="{{ event.href }}"{% if event.href | isExternalUrl %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ event.buttonLabel or "Mehr anzeigen" }}</a>
      {% elif event.details %}
        <button class="pill-button pill-button--ghost pill-button--compact event-feature-row__button" type="button" data-event-modal-open="event-modal-{{ event.id }}">{{ event.buttonLabel or "Mehr anzeigen" }}</button>
      {% endif %}
    </div>
    <figure class="event-feature-row__visual">
      {% if event.visual and event.visual.type == "image" %}
        <img src="{{ event.visual.src }}" alt="{{ event.visual.alt or '' }}" decoding="async" loading="lazy">
      {% else %}
        <div class="event-feature-row__placeholder event-feature-row__placeholder--{{ event.visual.tone or 'accent' }}" aria-hidden="true">
          <span>{{ event.visual.label if event.visual and event.visual.label else event.location }}</span>
        </div>
      {% endif %}
    </figure>
  </article>
{% endmacro %}
