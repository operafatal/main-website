{% macro marquee(items) %}
  <section class="marquee" aria-label="Selected institutions and venues">
    <div class="marquee__track">
      <ul class="marquee__list">
        {% for item in items %}
          <li class="marquee__item{% if item.logo %} marquee__item--logo{% endif %}{% if item.id %} marquee__item--{{ item.id }}{% endif %}">
            {% if item.logo %}
              <img class="marquee__logo" src="{{ item.logo }}" alt="{{ item.name }}" decoding="async">
            {% else %}
              <span translate="no">{{ item }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      <ul class="marquee__list" aria-hidden="true">
        {% for item in items %}
          <li class="marquee__item{% if item.logo %} marquee__item--logo{% endif %}{% if item.id %} marquee__item--{{ item.id }}{% endif %}">
            {% if item.logo %}
              <img class="marquee__logo" src="{{ item.logo }}" alt="" decoding="async">
            {% else %}
              <span translate="no">{{ item }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% endmacro %}
